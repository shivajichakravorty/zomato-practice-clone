{
  "info": {
    "name": "Zomato API",
    "description": "Complete API test collection for Zomato backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Food Partner Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Test Restaurant\",\"email\":\"partner@test.com\",\"password\":\"password123\"}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/foodpartner/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "foodpartner", "register"]
            }
          }
        },
        {
          "name": "Food Partner Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.globals.set('jwt_token', pm.cookies.get('token'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"partner@test.com\",\"password\":\"password123\"}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/foodpartner/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "foodpartner", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Food",
      "item": [
        {
          "name": "Create Food Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{jwt_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Biryani",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Delicious biryani with full of flavors",
                  "type": "text"
                },
                {
                  "key": "video",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "http://localhost:3000/api/food/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "food", ""]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ]
}
